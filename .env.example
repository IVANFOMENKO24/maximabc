# ------------------------------------------------------------------
# Пример файла настроек бота. Скопируй его в .env и подставь свои
# значения (файл .env никогда не заливается в GitHub).
# ------------------------------------------------------------------

# Telegram-токен бота (получаешь у @BotFather):
BOT_TOKEN=1234567890:AAH5exampleTOKEN1234567890abcdef

# (необязательно) Полный путь к бинарнику ffmpeg, если он не в PATH:
# Linux пример:   FFMPEG_PATH=/usr/bin/ffmpeg
# macOS пример:   FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# Windows пример: FFMPEG_PATH=C:\FFmpeg\bin\ffmpeg.exe
#FFMPEG_PATH=
